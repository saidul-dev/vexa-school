## Dependencies
/vendor
/node_modules

## Environment / secrets
.env
.env.backup
.env.production
.env.*.local

## Laravel storage & cache (generated at runtime)
/storage/*.key
/storage/app/*
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php

## Public assets built/linked, not source
/public/storage
/public/hot

## User uploads bundled with the CodeCanyon demo data
/upload/*
!/upload/.gitkeep

## Runtime file uploads (logos, thumbnails, docs, etc.) - already-committed demo
## files stay tracked, but new files saved into these folders are not tracked
/public/assets/uploads/course_thumbnails/*
/public/assets/uploads/email_logo/*
/public/assets/uploads/frontend_features/*
/public/assets/uploads/lesson-image/*
/public/assets/uploads/logo/*
/public/assets/uploads/noticeboard/*
/public/assets/uploads/offline_payment/*
/public/assets/uploads/school_logo/*
/public/assets/uploads/syllabus/*
/public/assets/uploads/user-docs/*
/public/assets/uploads/user-images/*

## Build tooling logs (compiled public/css, public/js, mix-manifest.json are tracked
## since they ship with the script and there's no guaranteed rebuild step)
npm-debug.log
yarn-error.log

## Testing
.phpunit.result.cache
/coverage

## IDE / OS
.idea
.vscode
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

## Homestead / Vagrant (in case used later)
Homestead.json
Homestead.yaml
.vagrant

## Misc local data dumps
*.sql
*.sqlite
Attendence_report.csv
